# Copia a ~/.config/airwork/agent.env y deja permisos 600:
#   install -Dm600 config/agent.env.example ~/.config/airwork/agent.env
# Aquí no van tokens: las cuentas se registran desde la PWA (perfiles de ~/.claude-accounts).

# --- Cloudflare Access (obligatorio fuera de modo desarrollo) ---
# Team domain de Zero Trust, sin https:// (Settings > Custom Pages / Team domain).
AIRWORK_ACCESS_TEAM_DOMAIN=mi-team.cloudflareaccess.com
# "Application Audience (AUD) Tag" de la aplicación Access de ESTE PC.
AIRWORK_ACCESS_AUD=
# Emails aceptados en el JWT, separados por coma. Deben coincidir con la política de Access.
AIRWORK_ALLOWED_EMAILS=tu-email@ejemplo.com

# --- Opcional ---
# Nombre que muestra la PWA; por defecto el hostname.
#AIRWORK_PC_NAME=pc-escritorio
# Puerto local; el host es siempre 127.0.0.1 (el agente se niega a escuchar en otra interfaz).
#AIRWORK_PORT=8790
#AIRWORK_PROGRAMMING_ROOT=~/programacion
#AIRWORK_ACCOUNTS_ROOT=~/.claude-accounts
#AIRWORK_CLAUDE_BIN=~/.local/bin/claude
#AIRWORK_HEADROOM_URL=http://127.0.0.1:8787
#AIRWORK_IDLE_TIMEOUT_S=900
#AIRWORK_PERMISSION_TIMEOUT_S=600
#AIRWORK_MAX_RUNS=4
# Permite guardar tokens OAuth cifrados por cuenta (desactivado: se prefieren perfiles).
#AIRWORK_ALLOW_TOKENS=0

# Nunca en producción: acepta peticiones sin JWT si no traen cf-ray.
#AIRWORK_DEV=0
